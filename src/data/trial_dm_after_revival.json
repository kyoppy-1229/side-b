[
  {
    "id": "trial-after-revival-001",
    "from": "水野",
    "text": "復刻版、見終わった？"
  },
  {
    "id": "trial-after-revival-002",
    "from": "主人公",
    "text": "だいたい回った"
  },
  {
    "id": "trial-after-revival-003",
    "from": "水野",
    "text": "どうだった"
  },
  {
    "id": "trial-after-revival-004",
    "from": "主人公",
    "text": "思ってたより覚えてたわ"
  },
  {
    "id": "trial-after-revival-005",
    "from": "水野",
    "text": "だろ"
  },
  {
    "id": "trial-after-revival-006",
    "from": "水野",
    "text": "そういえばなんだけど"
  },
  {
    "id": "trial-after-revival-007",
    "from": "水野",
    "text": "昔、SIDE-Bのことが書き込まれてた掲示板があったんだよ"
  },
  {
    "id": "trial-after-revival-008",
    "from": "主人公",
    "text": "掲示板？"
  },
  {
    "id": "trial-after-revival-009",
    "from": "水野",
    "text": "当時のやつ"
  },
  {
    "id": "trial-after-revival-010",
    "from": "水野",
    "text": "まだ残ってるかもしれん"
  },
  {
    "id": "trial-after-revival-011",
    "from": "主人公",
    "text": "見てみたいかも"
  },
  {
    "id": "trial-after-revival-012",
    "from": "水野",
    "text": "俺も探したんだけど、板から辿っても出てこないんだよな"
  },
  {
    "id": "trial-after-revival-013",
    "from": "水野",
    "text": "消されたスレは管理人が別のところに移してるらしい"
  },
  {
    "id": "trial-after-revival-014",
    "from": "水野",
    "text": "残ってるなら、そこにあると思う"
  },
  {
    "id": "trial-after-revival-015",
    "from": "主人公",
    "text": "自分で探してみる"
  }
]
