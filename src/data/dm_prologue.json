[
  { "id": "prologue-dm-001", "from": "水野", "text": "起きてる？" },
  { "id": "prologue-dm-002", "from": "主人公", "text": "起きてるけど、どうした？" },
  { "id": "prologue-dm-003", "from": "水野", "text": "この前同窓会で話してたSIDE-B覚えてる？" },
  { "id": "prologue-dm-004", "from": "主人公", "text": "同窓会の？" },
  { "id": "prologue-dm-005", "from": "水野", "text": "そう" },
  { "id": "prologue-dm-006", "from": "水野", "text": "なんとなく気になって、あとで調べてたんだけど" },
  { "id": "prologue-dm-007", "from": "水野", "text": "それっぽいの見つけた" },
  { "id": "prologue-dm-008", "from": "主人公", "text": "マジで？" },
  { "id": "prologue-dm-009", "from": "水野", "text": "なんか「REVIVAL」って書いてある" },
  { "id": "prologue-dm-010", "from": "主人公", "text": "復刻版？" },
  { "id": "prologue-dm-011", "from": "水野", "text": "たぶん" },
  { "id": "prologue-dm-012", "from": "水野", "text": "昔のままじゃないっぽいけど" },
  { "id": "prologue-dm-013", "from": "水野", "text": "ちょっとだけ開いてみたら普通に動いた" },
  { "id": "prologue-dm-014", "from": "主人公", "text": "誰が復刻したんだろ" },
  { "id": "prologue-dm-015", "from": "水野", "text": "分からん" },
  { "id": "prologue-dm-016", "from": "水野", "text": "その辺、何も書いてない" },
  { "id": "prologue-dm-017", "from": "主人公", "text": "それ若干怪しくない？w" },
  { "id": "prologue-dm-018", "from": "水野", "text": "俺も思ったw" },
  { "id": "prologue-dm-019", "from": "水野", "text": "でもなんか懐かしかったぞ" },
  { "id": "prologue-dm-020", "from": "水野", "text": "送る？" },
  { "id": "prologue-dm-021", "from": "主人公", "text": "送って" },
  { "id": "prologue-dm-022", "from": "水野", "text": "これ" }
]
